{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "president_2000",
  "compatibility_date": "2026-10-13",
  "main": "src/index.js",
  "observability": {
    "enabled": true
  },
  // Attached to the shared hostname by path-scoped Routes, NOT a Custom Domain
  // — the `games` hub Worker holds that. Cloudflare matches the most-specific
  // route first, so these peel /president_2000 off the hub.
  // Two patterns: `/*` does not match the bare prefix, and the bare prefix is
  // what src/index.js redirects to the trailing-slash form.
  "routes": [
    { "pattern": "games.csiesheep.com/president_2000", "zone_name": "csiesheep.com" },
    { "pattern": "games.csiesheep.com/president_2000/*", "zone_name": "csiesheep.com" }
  ],
  // Only public/ is uploaded as static assets; src/ is bundled into the Worker.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // One Durable Object per multiplayer room, named by its four-letter code;
  // one per client address (CF-Connecting-IP) for its rate limits (#101).
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LIMITS", "class_name": "Limits" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Limits"] }
  ]
}
